// ── Active Chats ────────────────────────────
app.get('/api/active-chats', async (req, res) => {
  try {
    const { data: leads, error } = await supabase.from('leads')
      .select('*').order('last_message_at', { ascending: false }).limit(100);
    if (error) throw error;

    const chats = await Promise.all(
      (leads || []).map(async (lead) => {
        const { data: msgs } = await supabase.from('conversations')
          .select('message, direction, created_at')
          .eq('phone', lead.phone)
          .order('created_at', { ascending: false }).limit(1);

        const unreadRes = await supabase.from('conversations')
          .select('id', { count: 'exact', head: true })
          .eq('phone', lead.phone).eq('direction', 'incoming').eq('status', 'received');

        return {
          ...lead,
          last_message: msgs?.[0] || null,
          unread_count: unreadRes.count || 0
        };
      })
    );

    res.json(chats);
  } catch (err) {
    res.status(500).json({ error: 'Failed to fetch active chats' });
  }
});

