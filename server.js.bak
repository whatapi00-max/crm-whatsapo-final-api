// ============================================
// WhatsApp CRM Pro - Server (Enhanced with wati.io features)
// ============================================
require('dotenv').config();

const express = require('express');
const cors = require('cors');
const helmet = require('helmet');
const rateLimit = require('express-rate-limit');
const { Client, LocalAuth } = require('whatsapp-web.js');
const qrcode = require('qrcode-terminal');
const QRCode = require('qrcode');
const { createClient } = require('@supabase/supabase-js');
const path = require('path');

// ── Config ──────────────────────────────────
const PORT = process.env.PORT || 3000;
const MESSAGE_DELAY_MS = parseInt(process.env.MESSAGE_DELAY_MS) || 2500;
let hasRealPhoneColumn = false;

// ── Supabase Client ─────────────────────────
const supabase = createClient(
  process.env.SUPABASE_URL,
  process.env.SUPABASE_KEY
);

// ── Phone Number Cleaner ────────────────────
function cleanPhone(raw) {
  if (!raw) return '';
  return raw.split('@')[0].replace(/\D/g, '');
}

// ── In-Memory Message Dedup ─────────────────
const processedMsgIds = new Set();
function isDuplicate(msgId) {
  if (!msgId) return false;
  if (processedMsgIds.has(msgId)) return true;
  processedMsgIds.add(msgId);
  if (processedMsgIds.size > 5000) {
    const arr = [...processedMsgIds];
    arr.slice(0, 2500).forEach(id => processedMsgIds.delete(id));
  }
  return false;
}

// ── Startup: Clean Dirty Phone Data ─────────
async function cleanupDirtyPhones() {
  try {
    const { data: badConvos } = await supabase
      .from('conversations')
      .select('id, phone')
      .like('phone', '%@%');

    if (badConvos && badConvos.length > 0) {
      console.log(`🧹 Cleaning ${badConvos.length} conversation phone numbers...`);
      for (const row of badConvos) {
        const fixed = cleanPhone(row.phone);
        await supabase.from('conversations').update({ phone: fixed }).eq('id', row.id);
      }
    }

    const { data: badLeads } = await supabase
      .from('leads')
      .select('id, phone')
      .like('phone', '%@%');

    if (badLeads && badLeads.length > 0) {
      console.log(`🧹 Cleaning ${badLeads.length} lead phone numbers...`);
      for (const row of badLeads) {
        const fixed = cleanPhone(row.phone);
        const { data: existing } = await supabase
          .from('leads')
          .select('id')
          .eq('phone', fixed)
          .neq('id', row.id)
          .maybeSingle();

        if (existing) {
          await supabase.from('leads').delete().eq('id', row.id);
        } else {
          await supabase.from('leads').update({ phone: fixed }).eq('id', row.id);
        }
      }
    }

    console.log('✅ Database cleanup complete');
  } catch (err) {
    console.error('⚠️  Cleanup error (non-fatal):', err.message);
  }
}

// ── Check real_phone column ─────────────────
async function checkRealPhoneColumn() {
  const { error } = await supabase.from('leads').select('real_phone').limit(1);
  if (error && error.message.includes('real_phone')) {
    console.log('⚠️  Column "real_phone" missing. Run the updated supabase.sql');
    hasRealPhoneColumn = false;
  } else {
    hasRealPhoneColumn = true;
    console.log('✅ real_phone column available');
  }
}
checkRealPhoneColumn();

// ── Express App ─────────────────────────────
const app = express();

app.use(helmet({
  contentSecurityPolicy: false,
  crossOriginEmbedderPolicy: false
}));
app.use(cors());
app.use(express.json({ limit: '5mb' }));
app.use(express.urlencoded({ extended: true }));
app.use(express.static(path.join(__dirname, 'public')));

const sendLimiter = rateLimit({
  windowMs: parseInt(process.env.RATE_LIMIT_WINDOW_MS) || 60000,
  max: parseInt(process.env.RATE_LIMIT_MAX) || 30,
  message: { error: 'Sending too fast, please wait a moment' },
  standardHeaders: true,
  legacyHeaders: false
});

// ── WhatsApp Client ─────────────────────────
let whatsappReady = false;
let qrCodeData = null;
let manualStatus = null; // null = auto-detect, 'banned' = manually set banned

const waClient = new Client({
  authStrategy: new LocalAuth({ dataPath: './.wwebjs_auth' }),
  webVersionCache: {
    type: 'remote',
    remotePath: 'https://raw.githubusercontent.com/wppconnect-team/wa-version/main/html/2.3000.1023231413-alpha.html'
  },
  puppeteer: {
    headless: true,
    executablePath: 'C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe',
    args: [
      '--no-sandbox',
      '--disable-setuid-sandbox',
      '--disable-dev-shm-usage',
      '--disable-accelerated-2d-canvas',
      '--no-first-run',
      '--disable-gpu',
      '--disable-extensions',
      '--disable-background-networking',
      '--disable-default-apps',
      '--disable-sync',
      '--disable-translate',
      '--hide-scrollbars',
      '--metrics-recording-only',
      '--mute-audio',
      '--no-default-browser-check',
      '--safebrowsing-disable-auto-update'
    ]
  }
});

waClient.on('qr', (qr) => {
  qrCodeData = qr;
  console.log('\n📱 Scan this QR code with WhatsApp:');
  qrcode.generate(qr, { small: true });
  console.log('Or open http://localhost:' + PORT + ' and check the QR tab\n');
});

waClient.on('ready', () => {
  whatsappReady = true;
  qrCodeData = null;
  console.log('✅ WhatsApp client is READY!');
  console.log('🖥️  Dashboard: http://localhost:' + PORT);
  setTimeout(() => resolveExistingLids(), 5000);
  startScheduledMessageChecker();
});

waClient.on('authenticated', () => {
  console.log('🔐 WhatsApp authenticated successfully');
});

waClient.on('auth_failure', (msg) => {
  console.error('❌ WhatsApp auth failure:', msg);
  whatsappReady = false;
  const msgStr = String(msg || '').toUpperCase();
  if (msgStr.includes('401') || msgStr.includes('CONFLICT') || msgStr.includes('BANNED') || msgStr.includes('UNLAUNCHED')) {
    console.error('🚫 Number appears to be BANNED by WhatsApp');
    manualStatus = 'banned';
  }
});

waClient.on('disconnected', (reason) => {
  console.log('⚠️  WhatsApp disconnected:', reason);
  whatsappReady = false;
  qrCodeData = null;
  const reasonStr = String(reason || '').toUpperCase();
  if (reasonStr.includes('CONFLICT') || reasonStr.includes('BANNED') || reasonStr === '401') {
    console.error('🚫 Number appears to be BANNED by WhatsApp');
    manualStatus = 'banned';
  } else if (reason !== 'LOGOUT') {
    console.log('🔄 Reconnecting in 10s...');
    setTimeout(() => waClient.initialize(), 10000);
  }
});

// ── Resolve Real Phone ──────────────────────
async function resolveRealPhone(msgOrJid, rawPhone) {
  try {
    let contact;
    if (typeof msgOrJid === 'object' && msgOrJid.getContact) {
      contact = await msgOrJid.getContact();
    } else if (typeof msgOrJid === 'string') {
      contact = await waClient.getContactById(msgOrJid);
    }

    if (contact) {
      if (contact.number) {
        const num = contact.number.replace(/\D/g, '');
        if (num && num !== rawPhone) return num;
      }
      if (contact.id?.user) {
        const idUser = contact.id.user.replace(/\D/g, '');
        if (idUser && idUser !== rawPhone && idUser.length >= 10 && idUser.length <= 15) return idUser;
      }
    }
  } catch (e) {
    console.log(`⚠️  resolveRealPhone error: ${e.message}`);
  }
  return null;
}

async function resolveExistingLids() {
  try {
    if (!whatsappReady || !hasRealPhoneColumn) return;
    const { data: lidLeads } = await supabase
      .from('leads')
      .select('id, phone, wa_jid, real_phone')
      .is('real_phone', null);

    if (!lidLeads || lidLeads.length === 0) return;
    console.log(`🔍 Resolving phone numbers for ${lidLeads.length} leads...`);

    for (const lead of lidLeads) {
      try {
        const jid = lead.wa_jid || lead.phone + '@c.us';
        const resolved = await resolveRealPhone(jid, lead.phone);
        if (resolved) {
          await supabase.from('leads').update({ real_phone: resolved }).eq('id', lead.id);
        }
        await delay(500);
      } catch (e) { /* skip */ }
    }
    console.log('✅ Phone number resolution complete');
  } catch (err) {
    console.log('⚠️  resolveExistingLids error:', err.message);
  }
}

// ── Auto-Reply Engine ───────────────────────
async function checkAutoReply(phone, body, isNew) {
  try {
    const { data: rules } = await supabase
      .from('auto_replies')
      .select('*')
      .eq('is_active', true)
      .order('priority', { ascending: false });

    if (!rules || rules.length === 0) return;

    const lowerBody = body.toLowerCase();

    for (const rule of rules) {
      let matched = false;

      if (rule.trigger_type === 'first_message' && isNew) {
        matched = true;
      } else if (rule.trigger_type === 'keyword') {
        const keywords = rule.trigger_value.toLowerCase().split(',').map(k => k.trim());
        matched = keywords.some(kw => lowerBody === kw);
      } else if (rule.trigger_type === 'contains') {
        const keywords = rule.trigger_value.toLowerCase().split(',').map(k => k.trim());
        matched = keywords.some(kw => lowerBody.includes(kw));
      } else if (rule.trigger_type === 'regex') {
        try {
          const re = new RegExp(rule.trigger_value, 'i');
          matched = re.test(body);
        } catch (_) { /* invalid regex */ }
      }

      if (matched) {
        await supabase.from('auto_replies').update({ usage_count: (rule.usage_count || 0) + 1 }).eq('id', rule.id);

        setTimeout(async () => {
          try {
            const { data: lead } = await supabase.from('leads').select('wa_jid').eq('phone', phone).maybeSingle();
            const chatId = lead?.wa_jid || phone + '@c.us';
            await waClient.sendMessage(chatId, rule.reply_message);
            console.log(`🤖 Auto-reply sent to ${phone}: "${rule.name}"`);
          } catch (e) {
            console.error('⚠️  Auto-reply send error:', e.message);
          }
        }, 1500);

        return;
      }
    }
  } catch (err) {
    console.error('⚠️  Auto-reply check error:', err.message);
  }
}

// ── Incoming Message Handler ────────────────
waClient.on('message', async (msg) => {
  try {
    const isGroup = msg.from.includes('@g.us');
    if (isGroup || msg.from === 'status@broadcast') return;

    let phone = cleanPhone(msg.from);
    const body = msg.body || '';
    if (!phone) return;

    const msgId = msg.id?._serialized;
    if (isDuplicate(msgId)) return;

    let resolvedPhone = null;
    const waJid = msg.from;
    if (waJid.includes('@lid')) {
      resolvedPhone = await resolveRealPhone(msg, phone);
    } else {
      resolvedPhone = phone;
    }

    console.log(`📩 Incoming from ${phone}: ${body.substring(0, 50)}`);

    await supabase.from('conversations').insert({
      phone,
      message: body,
      direction: 'incoming',
      status: 'received'
    });

    const { data: existingLead } = await supabase
      .from('leads')
      .select(hasRealPhoneColumn ? 'id, phone, real_phone' : 'id, phone')
      .eq('phone', phone)
      .maybeSingle();

    const isNew = !existingLead;

    if (!existingLead) {
      let source = 'organic';
      const lowerBody = body.toLowerCase();
      if (lowerBody.includes('tips') || lowerBody.includes('ad')) source = 'meta_ads';

      const insertData = {
        phone,
        wa_jid: waJid,
        name: msg._data?.notifyName || 'Unknown',
        source,
        status: 'new',
        last_message_at: new Date().toISOString()
      };
      if (hasRealPhoneColumn && resolvedPhone) insertData.real_phone = resolvedPhone;

      await supabase.from('leads').insert(insertData);

      await supabase.from('activity_log').insert({
        phone, action: 'lead_created',
        details: `New lead from ${source}: ${msg._data?.notifyName || 'Unknown'}`
      }).then(() => {}).catch(() => {});
    } else {
      const updates = { last_message_at: new Date().toISOString(), wa_jid: waJid };
      if (hasRealPhoneColumn && resolvedPhone && !existingLead.real_phone) {
        updates.real_phone = resolvedPhone;
      }
      await supabase.from('leads').update(updates).eq('phone', phone);
    }

    if (whatsappReady) {
      await checkAutoReply(phone, body, isNew);
    }
  } catch (err) {
    console.error('❌ Error handling incoming message:', err.message);
  }
});

// ── Outgoing Message Handler ────────────────
waClient.on('message_create', async (msg) => {
  if (!msg.fromMe) return;
  try {
    const isGroup = msg.to.includes('@g.us');
    if (isGroup || msg.to === 'status@broadcast') return;

    const phone = cleanPhone(msg.to);
    if (!phone) return;

    const msgId = msg.id?._serialized;
    if (isDuplicate(msgId)) return;

    await supabase.from('conversations').insert({
      phone,
      message: msg.body || '',
      direction: 'outgoing',
      status: 'sent'
    });
  } catch (err) {
    console.error('❌ Error saving outgoing message:', err.message);
  }
});

// ── Delay Helper ────────────────────────────
function delay(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

// ── Scheduled Message Checker ───────────────
let scheduledInterval = null;
function startScheduledMessageChecker() {
  if (scheduledInterval) clearInterval(scheduledInterval);
  scheduledInterval = setInterval(async () => {
    try {
      if (!whatsappReady) return;

      const { data: pending } = await supabase
        .from('scheduled_messages')
        .select('*')
        .eq('status', 'pending')
        .lte('scheduled_at', new Date().toISOString())
        .order('scheduled_at', { ascending: true })
        .limit(10);

      if (!pending || pending.length === 0) return;

      for (const sm of pending) {
        try {
          const cleanedPhone = sm.phone.replace(/\D/g, '');
          const { data: lead } = await supabase.from('leads').select('wa_jid').eq('phone', cleanedPhone).maybeSingle();
          const chatId = lead?.wa_jid || cleanedPhone + '@c.us';

          await delay(MESSAGE_DELAY_MS);
          await waClient.sendMessage(chatId, sm.message);

          await supabase.from('scheduled_messages')
            .update({ status: 'sent', sent_at: new Date().toISOString() })
            .eq('id', sm.id);

          console.log(`⏰ Scheduled message sent to ${cleanedPhone}`);
        } catch (e) {
          await supabase.from('scheduled_messages')
            .update({ status: 'failed', error_message: e.message })
            .eq('id', sm.id);
        }
      }
    } catch (err) {
      console.error('⚠️  Scheduled message checker error:', err.message);
    }
  }, 30000);
}

// ══════════════════════════════════════════════
// API ROUTES
// ══════════════════════════════════════════════

// ── Health Check ────────────────────────────
app.get('/api/health', (req, res) => {
  const waStatus = manualStatus === 'banned' ? 'banned' : (whatsappReady ? 'connected' : 'disconnected');
  res.json({
    status: 'ok',
    whatsapp: waStatus,
    uptime: Math.floor(process.uptime()),
    timestamp: new Date().toISOString()
  });
});

// ── Connection Status Override ──────────────
app.post('/api/connection-status', express.json(), (req, res) => {
  const { status } = req.body;
  if (status === 'banned') {
    manualStatus = 'banned';
    res.json({ ok: true, status: 'banned' });
  } else if (status === 'connected' || status === 'auto') {
    manualStatus = null;
    res.json({ ok: true, status: whatsappReady ? 'connected' : 'disconnected' });
  } else {
    res.status(400).json({ error: 'Invalid status. Use: banned, connected, auto' });
  }
});

app.get('/api/connection-status', (req, res) => {
  res.json({ manualStatus, whatsappReady });
});

// ── QR Code ─────────────────────────────────
app.get('/api/qr-status', (req, res) => {
  res.json({ ready: whatsappReady, qr: qrCodeData, banned: manualStatus === 'banned' });
});

app.get('/api/qr-image', async (req, res) => {
  if (whatsappReady) return res.json({ ready: true, image: null });
  if (!qrCodeData) return res.json({ ready: false, image: null });
  try {
    const dataUrl = await QRCode.toDataURL(qrCodeData, {
      width: 280, margin: 2,
      color: { dark: '#000000', light: '#ffffff' }
    });
    res.json({ ready: false, image: dataUrl });
  } catch (err) {
    res.status(500).json({ error: 'QR generation failed' });
  }
});

// ── Send Reply ──────────────────────────────
app.post('/api/send-reply', sendLimiter, async (req, res) => {
  try {
    const { phone, message } = req.body;
    if (!phone || !message) return res.status(400).json({ error: 'Phone and message are required' });
    if (!whatsappReady) return res.status(503).json({ error: 'WhatsApp not connected' });

    const cleanedPhone = phone.replace(/\D/g, '');
    if (cleanedPhone.length < 10 || cleanedPhone.length > 15) {
      return res.status(400).json({ error: 'Invalid phone number format' });
    }

    let chatId;
    const { data: lead } = await supabase
      .from('leads')
      .select('wa_jid')
      .eq('phone', cleanedPhone)
      .maybeSingle();

    if (lead?.wa_jid) {
      chatId = lead.wa_jid;
    } else {
      try {
        const numberId = await waClient.getNumberId(cleanedPhone);
        if (numberId) chatId = numberId._serialized;
      } catch (_) { /* ignore */ }
      if (!chatId) chatId = cleanedPhone + '@c.us';
    }

    await delay(MESSAGE_DELAY_MS);
    if (!whatsappReady) return res.status(503).json({ error: 'WhatsApp disconnected' });

    await waClient.sendMessage(chatId, message);
    console.log(`📤 Sent to ${cleanedPhone}: ${message.substring(0, 50)}`);

    await supabase.from('leads')
      .update({ last_message_at: new Date().toISOString() })
      .eq('phone', cleanedPhone);

    res.json({ success: true, phone: cleanedPhone });
  } catch (err) {
    console.error('❌ Send error:', err.message);
    res.status(500).json({ error: err.message || 'Failed to send message' });
  }
});

// ── Messages ────────────────────────────────
app.get('/api/messages', async (req, res) => {
  try {
    const { phone, limit = 50 } = req.query;
    let query = supabase.from('conversations').select('*')
      .order('created_at', { ascending: false }).limit(parseInt(limit));
    if (phone) query = query.eq('phone', phone);
    const { data, error } = await query;
    if (error) throw error;
    res.json(data || []);
  } catch (err) {
    res.status(500).json({ error: 'Failed to fetch messages' });
  }
});

app.get('/api/messages/:phone', async (req, res) => {
  try {
    const phone = req.params.phone.replace(/\D/g, '');
    const { data, error } = await supabase.from('conversations')
      .select('*').eq('phone', phone)
      .order('created_at', { ascending: true }).limit(200);
    if (error) throw error;
    res.json(data || []);
  } catch (err) {
    res.status(500).json({ error: 'Failed to fetch chat' });
  }
});

app.post('/api/messages/:phone/read', async (req, res) => {
  try {
    const phone = req.params.phone.replace(/\D/g, '');
    await supabase.from('conversations')
      .update({ status: 'read' })
      .eq('phone', phone).eq('direction', 'incoming').eq('status', 'received');
    res.json({ success: true });
  } catch (err) {
    res.status(500).json({ error: 'Failed to mark as read' });
  }
});

// ── Leads ───────────────────────────────────
app.get('/api/leads', async (req, res) => {
  try {
    const { status, source } = req.query;
    let query = supabase.from('leads').select('*')
      .order('last_message_at', { ascending: false });
    if (status) query = query.eq('status', status);
    if (source) query = query.eq('source', source);
    const { data, error } = await query;
    if (error) throw error;
    res.json(data || []);
  } catch (err) {
    res.status(500).json({ error: 'Failed to fetch leads' });
  }
});

app.put('/api/leads/:phone', async (req, res) => {
  try {
    const phone = req.params.phone.replace(/\D/g, '');
    const { name, status, revenue, tags, notes, source, email, company, assigned_to } = req.body;
    const updates = {};

    if (name !== undefined) updates.name = String(name).substring(0, 100);
    if (hasRealPhoneColumn && req.body.real_phone !== undefined) updates.real_phone = String(req.body.real_phone).substring(0, 30);
    if (email !== undefined) updates.email = String(email).substring(0, 150);
    if (company !== undefined) updates.company = String(company).substring(0, 150);
    if (assigned_to !== undefined) updates.assigned_to = String(assigned_to).substring(0, 100);
    if (status !== undefined) {
      const validStatuses = ['new', 'contacted', 'interested', 'negotiation', 'sold', 'lost'];
      if (!validStatuses.includes(status)) return res.status(400).json({ error: 'Invalid status' });
      updates.status = status;
    }
    if (revenue !== undefined) updates.revenue = parseFloat(revenue) || 0;
    if (tags !== undefined) updates.tags = Array.isArray(tags) ? tags : [];
    if (notes !== undefined) updates.notes = String(notes).substring(0, 5000);
    if (source !== undefined) updates.source = String(source).substring(0, 50);

    const { data, error } = await supabase.from('leads')
      .update(updates).eq('phone', phone).select().single();
    if (error) throw error;

    await supabase.from('activity_log').insert({
      phone, action: 'lead_updated', details: `Updated: ${Object.keys(updates).join(', ')}`
    }).then(() => {}).catch(() => {});

    res.json(data);
  } catch (err) {
    res.status(500).json({ error: 'Failed to update lead' });
  }
});

app.delete('/api/leads/:phone', async (req, res) => {
  try {
    const phone = req.params.phone.replace(/\D/g, '');
    await supabase.from('conversations').delete().eq('phone', phone);
    await supabase.from('leads').delete().eq('phone', phone);
    res.json({ success: true });
  } catch (err) {
    res.status(500).json({ error: 'Failed to delete lead' });
  }
});

// ── Resolve Phone ───────────────────────────
app.post('/api/leads/:phone/resolve', async (req, res) => {
  try {
    if (!whatsappReady) return res.status(503).json({ error: 'WhatsApp not connected' });
    const phone = req.params.phone.replace(/\D/g, '');
    const { data: lead } = await supabase.from('leads')
      .select('id, wa_jid, real_phone').eq('phone', phone).maybeSingle();
    if (!lead) return res.status(404).json({ error: 'Lead not found' });

    const jid = lead.wa_jid || phone + '@c.us';
    const resolved = await resolveRealPhone(jid, phone);
    if (resolved) {
      await supabase.from('leads').update({ real_phone: resolved }).eq('id', lead.id);
      res.json({ success: true, real_phone: resolved });
    } else {
      res.json({ success: false, message: 'Could not resolve. Enter manually.' });
    }
  } catch (err) {
    res.status(500).json({ error: 'Failed to resolve phone' });
  }
});

// ── Dashboard Stats ─────────────────────────
app.get('/api/stats', async (req, res) => {
  try {
    const { data: statsData, error: statsError } = await supabase
      .from('dashboard_stats').select('*').single();

    if (statsError) {
      const [leadsRes, soldRes, newRes, intRes, contRes, revenueRes, msgsRes, inRes, outRes] = await Promise.all([
        supabase.from('leads').select('id', { count: 'exact', head: true }),
        supabase.from('leads').select('id', { count: 'exact', head: true }).eq('status', 'sold'),
        supabase.from('leads').select('id', { count: 'exact', head: true }).eq('status', 'new'),
        supabase.from('leads').select('id', { count: 'exact', head: true }).eq('status', 'interested'),
        supabase.from('leads').select('id', { count: 'exact', head: true }).eq('status', 'contacted'),
        supabase.from('leads').select('revenue'),
        supabase.from('conversations').select('id', { count: 'exact', head: true })
          .gte('created_at', new Date(Date.now() - 86400000).toISOString()),
        supabase.from('conversations').select('id', { count: 'exact', head: true })
          .eq('direction', 'incoming')
          .gte('created_at', new Date(Date.now() - 86400000).toISOString()),
        supabase.from('conversations').select('id', { count: 'exact', head: true })
          .eq('direction', 'outgoing')
          .gte('created_at', new Date(Date.now() - 86400000).toISOString())
      ]);

      const totalRevenue = (revenueRes.data || []).reduce((sum, l) => sum + (parseFloat(l.revenue) || 0), 0);

      return res.json({
        total_leads: leadsRes.count || 0,
        new_leads: newRes.count || 0,
        sold_leads: soldRes.count || 0,
        interested_leads: intRes.count || 0,
        contacted_leads: contRes.count || 0,
        total_revenue: totalRevenue,
        messages_today: msgsRes.count || 0,
        incoming_today: inRes.count || 0,
        outgoing_today: outRes.count || 0
      });
    }

    res.json(statsData);
  } catch (err) {
    res.status(500).json({ error: 'Failed to fetch stats' });
  }
});

app.get('/api/stats/revenue-by-status', async (req, res) => {
  try {
    const { data, error } = await supabase.from('leads').select('status, revenue');
    if (error) throw error;
    const byStatus = {};
    (data || []).forEach(lead => {
      if (!byStatus[lead.status]) byStatus[lead.status] = { count: 0, revenue: 0 };
      byStatus[lead.status].count++;
      byStatus[lead.status].revenue += parseFloat(lead.revenue) || 0;
    });
    res.json(byStatus);
  } catch (err) {
    res.status(500).json({ error: 'Failed to fetch revenue data' });
  }
});

// ── Analytics - Message trends ──────────────
app.get('/api/stats/trends', async (req, res) => {
  try {
    const days = parseInt(req.query.days) || 7;
    const since = new Date(Date.now() - days * 86400000).toISOString();

    const { data, error } = await supabase.from('conversations')
      .select('direction, created_at')
      .gte('created_at', since)
      .order('created_at', { ascending: true });

    if (error) throw error;

    const trends = {};
    (data || []).forEach(msg => {
      const day = new Date(msg.created_at).toISOString().split('T')[0];
      if (!trends[day]) trends[day] = { incoming: 0, outgoing: 0 };
      trends[day][msg.direction]++;
    });

    res.json(trends);
  } catch (err) {
    res.status(500).json({ error: 'Failed to fetch trends' });
  }
});

// ── Quick Replies CRUD ──────────────────────
app.get('/api/quick-replies', async (req, res) => {
  try {
    const { data, error } = await supabase.from('quick_replies')
      .select('*').order('id');
    if (error) throw error;
    // Deduplicate by title (keep lowest id) in case of DB duplicates
    const seen = new Set();
    const unique = (data || []).filter(r => {
      if (seen.has(r.title)) return false;
      seen.add(r.title);
      return true;
    });
    res.json(unique);
  } catch (err) {
    res.status(500).json({ error: 'Failed to fetch quick replies' });
  }
});

app.post('/api/quick-replies', async (req, res) => {
  try {
    const { title, message, category, shortcut } = req.body;
    if (!title || !message) return res.status(400).json({ error: 'Title and message required' });
    const { data, error } = await supabase.from('quick_replies')
      .insert({
        title: String(title).substring(0, 100),
        message: String(message).substring(0, 2000),
        category: String(category || 'general').substring(0, 50),
        shortcut: shortcut ? String(shortcut).substring(0, 30) : null
      }).select().single();
    if (error) throw error;
    res.json(data);
  } catch (err) {
    res.status(500).json({ error: 'Failed to create quick reply' });
  }
});

app.put('/api/quick-replies/:id', async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    const { title, message, category, shortcut } = req.body;
    const updates = {};
    if (title !== undefined) updates.title = String(title).substring(0, 100);
    if (message !== undefined) updates.message = String(message).substring(0, 2000);
    if (category !== undefined) updates.category = String(category).substring(0, 50);
    if (shortcut !== undefined) updates.shortcut = shortcut ? String(shortcut).substring(0, 30) : null;
    const { data, error } = await supabase.from('quick_replies')
      .update(updates).eq('id', id).select().single();
    if (error) throw error;
    res.json(data);
  } catch (err) {
    res.status(500).json({ error: 'Failed to update quick reply' });
  }
});

app.delete('/api/quick-replies/:id', async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    // Get the title so we can also delete all duplicates with same title
    const { data: target } = await supabase.from('quick_replies').select('title').eq('id', id).maybeSingle();
    if (target) {
      await supabase.from('quick_replies').delete().eq('title', target.title);
    } else {
      await supabase.from('quick_replies').delete().eq('id', id);
    }
    res.json({ success: true });
  } catch (err) {
    res.status(500).json({ error: 'Failed to delete quick reply' });
  }
});

