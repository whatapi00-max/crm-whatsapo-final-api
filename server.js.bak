// ── Broadcast Campaigns ─────────────────────
app.get('/api/broadcasts', async (req, res) => {
  try {
    const { data, error } = await supabase.from('broadcasts')
      .select('*').order('created_at', { ascending: false });
    if (error) throw error;
    res.json(data || []);
  } catch (err) {
    res.status(500).json({ error: 'Failed to fetch broadcasts' });
  }
});

app.post('/api/broadcasts', async (req, res) => {
  try {
    const { name, message, target_filter, template_id } = req.body;
    if (!name || !message) return res.status(400).json({ error: 'Name and message required' });

    let query = supabase.from('leads').select('phone');
    const filter = target_filter || {};
    if (filter.status) query = query.eq('status', filter.status);
    if (filter.source) query = query.eq('source', filter.source);
    if (filter.tags && filter.tags.length > 0) query = query.overlaps('tags', filter.tags);

    const { data: targets } = await query;
    const targetCount = (targets || []).length;

    const { data, error } = await supabase.from('broadcasts')
      .insert({
        name: String(name).substring(0, 150),
        message: String(message).substring(0, 4096),
        template_id: template_id || null,
        target_filter: filter,
        target_count: targetCount,
        status: 'draft'
      }).select().single();
    if (error) throw error;

    if (targets && targets.length > 0) {
      const recipients = targets.map(t => ({
        broadcast_id: data.id,
        phone: t.phone,
        status: 'pending'
      }));
      await supabase.from('broadcast_recipients').insert(recipients);
    }

    res.json(data);
  } catch (err) {
    res.status(500).json({ error: 'Failed to create broadcast' });
  }
});

app.post('/api/broadcasts/:id/send', async (req, res) => {
  try {
    if (!whatsappReady) return res.status(503).json({ error: 'WhatsApp not connected' });

    const id = parseInt(req.params.id);
    const { data: broadcast } = await supabase.from('broadcasts')
      .select('*').eq('id', id).single();

    if (!broadcast) return res.status(404).json({ error: 'Broadcast not found' });
    if (broadcast.status === 'sending') return res.status(400).json({ error: 'Already sending' });
    if (broadcast.status === 'completed') return res.status(400).json({ error: 'Already completed' });

    await supabase.from('broadcasts')
      .update({ status: 'sending', started_at: new Date().toISOString() })
      .eq('id', id);

    sendBroadcastAsync(id, broadcast.message);

    res.json({ success: true, message: 'Broadcast started' });
  } catch (err) {
    res.status(500).json({ error: 'Failed to start broadcast' });
  }
});

async function sendBroadcastAsync(broadcastId, message) {
  try {
    const { data: recipients } = await supabase.from('broadcast_recipients')
      .select('*').eq('broadcast_id', broadcastId).eq('status', 'pending');

    let sentCount = 0;
    let failedCount = 0;

    for (const recipient of (recipients || [])) {
      try {
        if (!whatsappReady) {
          await supabase.from('broadcast_recipients')
            .update({ status: 'failed', error_message: 'WhatsApp disconnected' })
            .eq('id', recipient.id);
          failedCount++;
          continue;
        }

        const cleanedPhone = recipient.phone.replace(/\D/g, '');
        const { data: lead } = await supabase.from('leads').select('wa_jid').eq('phone', cleanedPhone).maybeSingle();
        const chatId = lead?.wa_jid || cleanedPhone + '@c.us';

        await delay(MESSAGE_DELAY_MS + Math.random() * 2000);
        await waClient.sendMessage(chatId, message);

        await supabase.from('broadcast_recipients')
          .update({ status: 'sent', sent_at: new Date().toISOString() })
          .eq('id', recipient.id);
        sentCount++;

        console.log(`📡 Broadcast sent to ${cleanedPhone} (${sentCount}/${recipients.length})`);
      } catch (e) {
        await supabase.from('broadcast_recipients')
          .update({ status: 'failed', error_message: e.message })
          .eq('id', recipient.id);
        failedCount++;
      }
    }

    await supabase.from('broadcasts').update({
      status: 'completed',
      sent_count: sentCount,
      failed_count: failedCount,
      completed_at: new Date().toISOString()
    }).eq('id', broadcastId);

    console.log(`✅ Broadcast #${broadcastId} complete: ${sentCount} sent, ${failedCount} failed`);
  } catch (err) {
    console.error('❌ Broadcast error:', err.message);
    await supabase.from('broadcasts').update({ status: 'cancelled' }).eq('id', broadcastId);
  }
}

app.get('/api/broadcasts/:id', async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    const { data: broadcast } = await supabase.from('broadcasts')
      .select('*').eq('id', id).single();
    if (!broadcast) return res.status(404).json({ error: 'Not found' });

    const { data: recipients } = await supabase.from('broadcast_recipients')
      .select('*').eq('broadcast_id', id).order('created_at');

    res.json({ ...broadcast, recipients: recipients || [] });
  } catch (err) {
    res.status(500).json({ error: 'Failed to fetch broadcast details' });
  }
});

app.delete('/api/broadcasts/:id', async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    await supabase.from('broadcast_recipients').delete().eq('broadcast_id', id);
    await supabase.from('broadcasts').delete().eq('id', id);
    res.json({ success: true });
  } catch (err) {
    res.status(500).json({ error: 'Failed to delete broadcast' });
  }
});

